{
  "name": "node-red-contrib-lynuc-cnc",
  "version": "0.1.0",
  "description": "Node-RED collector for LYNUC CNC controllers over the native RemoteComm protocol (TCP 4011). Pure JavaScript, read-only.",
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "node-red",
    "cnc",
    "lynuc",
    "iiot"
  ],
  "files": [
    "lib",
    "nodes",
    "tools",
    "examples",
    "docs/POINTS.md",
    "docs/SITE_ACCEPTANCE.md"
  ],
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "lynuc-cnc": "nodes/lynuc-cnc.js"
    }
  },
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:conformance": "node test/conformance/run.js",
    "simulate": "node tools/simulator.js"
  },
  "devDependencies": {
    "node-red": "^5.0.9",
    "node-red-node-test-helper": "^0.3.6"
  }
}
