[
  {
    "id": "lynuc.flow",
    "type": "tab",
    "label": "LYNUC CNC 采集",
    "disabled": false,
    "info": "采集铼钠克 CNC 数据并发布到 MQTT。使用前修改控制器 IP 和 MQTT Broker 地址。"
  },
  {
    "id": "lynuc.broker",
    "type": "mqtt-broker",
    "name": "IIoT Broker",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "lynuc.trigger",
    "type": "inject",
    "z": "lynuc.flow",
    "name": "立即采集",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 140,
    "y": 100,
    "wires": [["lynuc.cnc"]]
  },
  {
    "id": "lynuc.reconnect",
    "type": "inject",
    "z": "lynuc.flow",
    "name": "重新连接",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "reconnect",
    "payloadType": "str",
    "x": 140,
    "y": 160,
    "wires": [["lynuc.cnc"]]
  },
  {
    "id": "lynuc.cnc",
    "type": "lynuc-cnc",
    "z": "lynuc.flow",
    "name": "CNC 1",
    "host": "192.168.1.100",
    "port": 4011,
    "deviceId": "CNC_001",
    "channel": 1,
    "axes": "X,Y,Z",
    "pollInterval": 1000,
    "connectTimeout": 3000,
    "requestTimeout": 1000,
    "autoReconnect": true,
    "reconnectInterval": 5000,
    "maxRetries": 0,
    "topic": "",
    "onlyOnChange": false,
    "deadband": 0,
    "groups": {
      "machineStatus": { "enabled": true, "every": 1 },
      "axes": { "enabled": true, "every": 1 },
      "spindle": { "enabled": true, "every": 1 },
      "feedrate": { "enabled": true, "every": 1 },
      "program": { "enabled": true, "every": 1 },
      "alarms": { "enabled": true, "every": 1 },
      "production": { "enabled": true, "every": 5 },
      "tool": { "enabled": true, "every": 5 },
      "system": { "enabled": true, "every": 60 }
    },
    "customPoints": "[]",
    "x": 340,
    "y": 130,
    "wires": [["lynuc.data.mqtt", "lynuc.data.debug"], ["lynuc.event.mqtt", "lynuc.event.debug"]]
  },
  {
    "id": "lynuc.data.mqtt",
    "type": "mqtt out",
    "z": "lynuc.flow",
    "name": "发布数据",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "broker": "lynuc.broker",
    "x": 560,
    "y": 80,
    "wires": []
  },
  {
    "id": "lynuc.event.mqtt",
    "type": "mqtt out",
    "z": "lynuc.flow",
    "name": "发布事件",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "broker": "lynuc.broker",
    "x": 560,
    "y": 180,
    "wires": []
  },
  {
    "id": "lynuc.data.debug",
    "type": "debug",
    "z": "lynuc.flow",
    "name": "数据",
    "active": false,
    "tosidebar": true,
    "console": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 550,
    "y": 120,
    "wires": []
  },
  {
    "id": "lynuc.event.debug",
    "type": "debug",
    "z": "lynuc.flow",
    "name": "事件",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 550,
    "y": 220,
    "wires": []
  }
]
